generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== ЗАЯВКИ С ФОРМЫ =====
model Application {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String?
  page      String?  // с какой страницы отправлена
  status    ApplicationStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("applications")
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ===== УСЛУГИ =====
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  description String?  @db.Text
  image       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       ServiceStep[]
  audiences   ServiceAudience[]

  @@map("services")
}

model ServiceStep {
  id        String  @id @default(cuid())
  serviceId String
  number    Int
  title     String
  text      String? @db.Text
  order     Int     @default(0)

  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_steps")
}

model ServiceAudience {
  id        String  @id @default(cuid())
  serviceId String
  title     String
  order     Int     @default(0)

  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_audiences")
}

// ===== ЛИЦЕНЗИИ =====
model License {
  id     String  @id @default(cuid())
  title  String
  issuer String?
  image  String?
  order  Int     @default(0)

  @@map("licenses")
}

// ===== ПРЕИМУЩЕСТВА =====
model Advantage {
  id    String  @id @default(cuid())
  title String
  text  String? @db.Text
  icon  String?
  order Int     @default(0)

  @@map("advantages")
}
